DATABASE_URL="file:./prisma/dev.db"
FRONTEND_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-a-local-development-secret"
JWT_EXPIRES_IN="7d"
DASHSCOPE_API_KEY="replace-with-your-dashscope-api-key"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen3.7-max"
LLM_ENABLE_THINKING="true"
LLM_TIMEOUT_MS="120000"
PLAN_LLM_TIMEOUT_MS="90000"
AMAP_WEB_SERVICE_KEY="replace-with-your-amap-web-service-key"
AMAP_JS_SECURITY_CODE="replace-with-your-amap-js-security-code"
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-qq-email@qq.com"
SMTP_PASS="replace-with-a-new-smtp-authorization-code"
MAIL_FROM="TravelByLLM <your-qq-email@qq.com>"
PUBLIC_WEB_URL="http://localhost:5173"
AUTH_CHALLENGE_SECRET="replace-with-a-long-random-challenge-secret"
